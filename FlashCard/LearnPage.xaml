<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlashCard.LearnPage"
             Title="">

    <Grid RowDefinitions="Auto, *, Auto" Padding="5" RowSpacing="20">
        <!-- En-tête -->
        <Label x:Name="DeckNameLabel" 
               Grid.Row="0" 
               Text="Nom du Deck" 
               FontSize="24" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" />

        <!-- Zone de la carte -->
        <Frame Grid.Row="1"
               x:Name="CardFrame"
               Padding="20"
               Margin="20"
               BackgroundColor="White"
               VerticalOptions="Center"
               HeightRequest="600">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCardTapped" />
            </Frame.GestureRecognizers>

            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                <Label x:Name="CardContentLabel"
                       Text="Contenu de la carte"
                       FontSize="24"
                       HorizontalTextAlignment="Center" />
                <Label x:Name="SideIndicatorLabel"
                       Text="Appuyez pour voir le verso"
                       FontSize="12"
                       TextColor="Gray"
                       HorizontalOptions="Center"
                       Margin="0,15,0,0"/>
                <Label x:Name="SideIndicatorLabel2"
                       Text="ou secouez votre téléphone pour ignorer cette carte"
                       FontSize="12"
                       TextColor="Gray"
                       HorizontalOptions="Center"
                       Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </Frame>

        <!-- Contrôles en bas -->
        <VerticalStackLayout Grid.Row="2" Spacing="20">
            <Label x:Name="ProgressLabel"
                   Text="Carte 1 / 10"
                   HorizontalOptions="Center" />

            <Grid ColumnDefinitions="*, *" ColumnSpacing="20" x:Name="ActionButtons" IsVisible="False" Padding="10">
                <Button Grid.Column="0"
                        Text="Faux"
                        BackgroundColor="#FF5252"
                        TextColor="White"
                        Padding="15"
                        Clicked="OnWrongClicked" />

                <Button Grid.Column="1"
                        Text="Juste"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        Padding="15"
                        Clicked="OnCorrectClicked" />
            </Grid>

            <Label Text="Appuyez sur la carte pour voir la réponse"
                   x:Name="InstructionLabel"
                   HorizontalOptions="Center"
                   TextColor="Gray"
                   FontSize="14"
                   Margin="25"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
